# ---- Server ----
APP_ENV=development                         # "production" enforces safe settings and refuses to start otherwise
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:8000            # production: https URL reachable by the bot and by Daily webhooks
INTERNAL_API_KEY=generate-a-long-random-string-here   # python -c "import secrets;print(secrets.token_urlsafe(48))"
DEV_AUTH=true                               # true only for local testing ("Bearer dev:<user_id>"); defaults to false in production
BOTS_ENABLED=true
CORS_ORIGINS=                               # comma-separated browser origins; mobile apps don't need this
LOGIN_MAX_ATTEMPTS=5                        # corporate PIN attempts per user / IP ...
LOGIN_WINDOW_S=900                          # ... per 15 minutes
RING_TIMEOUT_S=60                           # unanswered app calls become "missed"

# ---- Daily ----
DAILY_API_KEY=
DAILY_CALLER_ID=                            # phone number id of your purchased Daily number (caller ID for dial-out)
DAILY_RECORDING_TYPE=cloud                  # or cloud-audio-only if enabled on your plan
DAILY_TRANSCRIPTION_MODEL=nova-3-general
DAILY_DIALIN_HMAC=                          # the "hmac" from your pinless_dialin config; required in production

# ---- AI (commitment extraction + the bot's spoken disclosure / voicemail greeting) ----
AI_PROVIDER=gemini                          # gemini | openai (empty = whichever has a key)
GEMINI_API_KEY=                             # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite          # fast + cheap (~3s per call); larger models think for 60s+
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Optional alternative:
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1
TTS_VOICE=alloy

# ---- Supabase (leave empty to run on the in-memory demo company; required in production) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=                        # only for legacy HS256 projects; otherwise JWKS is used

# ---- Push (Firebase Cloud Messaging HTTP v1) ----
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

REMINDER_LEAD_HOURS=24
SCHEDULER_INTERVAL_S=300
